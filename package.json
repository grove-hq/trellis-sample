{
  "name": "trellis-sample",
  "version": "0.0.0",
  "private": true,
  "description": "A sample app showing Trellis patterns in a real repo.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
